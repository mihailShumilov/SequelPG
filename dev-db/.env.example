# Copy to `.env` and edit if needed. Defaults work out of the box.

# Host port the container binds to. 54318 (PG-18) is unlikely to clash with
# stock 5432 or other tools; pick anything in 49152-65535 if you prefer.
POSTGRES_PORT=54318

# Credentials for the demo database. Used by both the container and Makefile
# helpers; change before exposing the port outside localhost.
POSTGRES_DB=demo
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo
